---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/FloatingContact.astro';
interface Props { title: string; description: string; image?: string; noindex?: boolean; jsonld?: any[]; type?: string; solidHeader?: boolean; preload?: boolean }
const { solidHeader = false, preload = false, ...seo } = Astro.props;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#142238" />
  <link rel="icon" type="image/png" href="/brand/logo-mark.png" />
  <link rel="apple-touch-icon" href="/brand/logo-mark.png" />
  <Seo {...seo} />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <slot name="head" />
</head>
<body data-preload={preload ? '1' : undefined}>
  <a class="skip" href="#main">تخطَّ إلى المحتوى</a>
  <Header solid={solidHeader} />
  <main id="main"><slot /></main>
  <Footer />
  <Contact />
  <div class="cursor" aria-hidden="true"><div class="cursor__ring"><span class="cursor__label">عرض</span></div><div class="cursor__dot"></div></div>
  <div class="grain" aria-hidden="true"></div>
  <script>
    import '../scripts/core';
  </script>
</body>
</html>
